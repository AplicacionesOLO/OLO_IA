# Plantilla de entorno del backend. Los valores reales van en el archivo de
# secretos, que está en .gitignore. Aquí no va ningún valor real.

ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# ── Base de datos ──────────────────────────────────────────────────────────
# SIEMPRE con el rol `olo_app`.
# Usar `postgres` o `service_role` aquí anularía por completo el aislamiento
# multi-tenant: ambos tienen BYPASSRLS.
# Pooler en modo transaction, puerto 6543 — es el modo compatible con el
# patrón set_config(..., is_local => true) que usa el backend.
DATABASE_URL=postgresql+asyncpg://olo_app:<password>@<host>:6543/postgres

# ── Verificación de JWT ────────────────────────────────────────────────────
# jwks  = claves asimétricas del proyecto (recomendado)
# hs256 = secreto compartido heredado; requiere JWT_SECRET
JWT_ALGORITHM=jwks
JWT_SECRET=
JWT_AUDIENCE=authenticated

# ── CORS ───────────────────────────────────────────────────────────────────
# Lista separada por comas. Vacía en local.
CORS_ORIGINS=
