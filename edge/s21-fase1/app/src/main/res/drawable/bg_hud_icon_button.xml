<?xml version="1.0" encoding="utf-8"?>
<!-- Boton circular tipo HUD (zoom +/-, cuadricula on/off) - fondo oscuro
     semitransparente con borde fino, para que se lea como "control de
     instrumento" y no como un boton de formulario. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#993FC1CE" />
            <stroke android:width="1.5dp" android:color="#3FC1CE" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#66000000" />
            <stroke android:width="1.5dp" android:color="#663FC1CE" />
        </shape>
    </item>
</selector>
