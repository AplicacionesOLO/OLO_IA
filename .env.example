# ═══════════════════════════════════════════════════════════════════════
# OLO_IA — PLANTILLA DE ENTORNO
#
# Este archivo (.env.example) SÍ se versiona: documenta la forma, no los
# valores. Los valores reales van en .env.local, que está en .gitignore.
#
# Rellenar: <raíz del proyecto>\.env.local
#
# La ruta va relativa a propósito: antes decía `docs\.envlocal`, que es un sitio
# equivocado —los secretos no viven en docs— y además una ruta absoluta que se
# rompe al mover el proyecto de carpeta.
# ═══════════════════════════════════════════════════════════════════════


# ── 1. SUPABASE: identidad del proyecto ────────────────────────────────
# Dashboard → Project Settings → General
# El ref son los 20 caracteres del subdominio: https://<REF>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=

# Dashboard → Project Settings → API Keys
# anon: clave pública, va al frontend. RLS la protege.
SUPABASE_ANON_KEY=

# ── 2. SUPABASE: acceso del CLI ────────────────────────────────────────
# Personal Access Token (empieza por sbp_). Se genera en:
# https://supabase.com/dashboard/account/tokens
# Con esto hago `supabase link`, `db push`, `db lint`, `db diff`.
SUPABASE_ACCESS_TOKEN=

# Password de la base de datos del proyecto.
# Dashboard → Project Settings → Database → Database password
# (si no la recuerdas, ahí mismo se puede resetear)
SUPABASE_DB_PASSWORD=

# ── 3. POSTGRES: conexiones directas ───────────────────────────────────
# Dashboard → Project Settings → Database → Connection string
#
# SESSION mode (puerto 5432): migraciones, psql, DDL.
DATABASE_URL=

# TRANSACTION mode (puerto 6543, el pooler): lo que usa la app en runtime.
# Compatible con nuestro patrón set_config(..., is_local=true).
DATABASE_POOL_URL=

# ── 4. ROL DE APLICACIÓN (lo creo yo en la primera migración) ──────────
# Rol `olo_app` sin BYPASSRLS: es el que usa el backend FastAPI para
# toda query con scope de tenant. Ver docs/RLS_STRATEGY.md §2.1.
# Genera una password larga y aleatoria; no reutilices la del proyecto.
OLO_APP_DB_PASSWORD=

# ── 5. BACKEND: origenes permitidos (CORS) ─────────────────────────────
# Lista separada por comas. SIN esto el navegador bloquea toda llamada del
# frontend al backend y el fallo aparece en la consola del navegador, no en
# los logs del backend, que es lo que lo hace desconcertante.
#
# ⚠ El frontend de este repositorio escucha en el puerto 3000, no en el 5173
#   por defecto de Vite: `frontend/vite.config.ts` fija `port: 3000` con
#   `strictPort: true`. Si aqui solo figura el 5173, el login falla desde la
#   interfaz aunque el backend responda perfectamente a curl. Ocurrio.
#
# Vacio = sin CORS: valido solo si nada de navegador consume la API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 6. service_role: SOLO para invitar usuarios ────────────────────────
# ⚠ Esta clave tiene BYPASSRLS: anula TODO el aislamiento multi-tenant.
#
# Tiene UN uso en el backend y solo uno: la llamada a la Admin API de Auth
# que invita a una persona (`POST /v1/admin/users/invite`). Ninguna consulta
# a la base pasa por ella —eso sigue yendo por `olo_app`, que no tiene
# BYPASSRLS—, y la imposibilidad es estructural: vive en
# `security/supabase_admin.py`, que no importa SQLAlchemy ni recibe sesion.
#
# Vacia es un valor valido: el sistema arranca igual e invitar responde
# diciendo que falta. El resto del producto funciona sin ella.
#
# Ademas hace falta SMTP configurado en Supabase (Authentication → Emails).
# Sin SMTP, Supabase acepta la llamada y el correo NO sale: la invitacion
# queda creada y la persona nunca la recibe.
SUPABASE_SERVICE_ROLE_KEY=

# ══════════════════════════════════════════════════════════════════════════
# OLOBOT — el asistente
#
# Sin `OLOBOT_API_KEY` el sistema arranca igual y OLOBOT responde que no esta
# configurado, con el motivo escrito. Hacerla obligatoria convertiria un
# asistente ausente en un servicio caido.
#
# El nivel de acceso de cada usuario NO se configura aqui: vive en la tabla
# `olobot.access` y se concede desde Configuracion del sistema. Un nivel en el
# entorno seria un privilegio sin rastro de quien lo dio.
# ══════════════════════════════════════════════════════════════════════════
OLOBOT_API_KEY=
OLOBOT_MODEL=gpt-4o-mini
OLOBOT_BASE_URL=https://api.openai.com/v1
# Cuantos turnos de herramienta antes de cortar. El bot consulta, lee y vuelve a
# consultar; sin tope, un modelo confundido encadena llamadas hasta agotar el
# presupuesto.
OLOBOT_MAX_TURNOS=6
OLOBOT_TIMEOUT_S=60
OLOBOT_HISTORIAL=24
