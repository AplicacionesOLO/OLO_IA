<?xml version="1.0" encoding="utf-8"?>
<!-- Misma paleta que bg_hud_icon_button.xml, pero rectangulo redondeado en
     vez de circulo, para textos mas largos (calidad de camara) que no caben
     en un circulo de icono. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#993FC1CE" />
            <stroke android:width="1.5dp" android:color="#3FC1CE" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66000000" />
            <stroke android:width="1.5dp" android:color="#663FC1CE" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
