# ═══════════════════════════════════════════════════════════════════════
# OLO IA — FRONTEND
#
# Este archivo SI se versiona: documenta la forma, nunca los valores.
# Copiar a .env.local (que esta en .gitignore) y rellenar.
#
# ⚠ Toda variable VITE_* acaba en el bundle y es PUBLICA.
#   Nunca poner aqui service_role, passwords ni secretos de ningun tipo.
# ═══════════════════════════════════════════════════════════════════════

# ── Backend propio ─────────────────────────────────────────────────────
# Origen de la API FastAPI. Sin barra final.
VITE_API_URL=http://localhost:8000

# ── Supabase Auth ──────────────────────────────────────────────────────
# El login va DIRECTO a Supabase Auth, no a traves del backend.
# Dashboard → Project Settings → General
VITE_SUPABASE_URL=

# Clave anonima. Es publica por diseño: RLS es lo que protege los datos.
# Dashboard → Project Settings → API Keys → anon
VITE_SUPABASE_ANON_KEY=

# ── Modo de autenticacion ──────────────────────────────────────────────
# mock     → sin Supabase. Cualquier credencial entra. Solo desarrollo de UI.
# supabase → autenticacion real.
#
# Si se deja vacio: se usa `supabase` cuando VITE_SUPABASE_URL esta
# rellenada, y `mock` cuando no lo esta.
VITE_AUTH_MODE=

# ── Capas visuales ─────────────────────────────────────────────────────
# Capa maxima a registrar. Permite forzar una capa inferior para comparar
# rendimiento sin desinstalar dependencias.
#   1 → React + Tailwind + Framer + SVG   (actual)
#   2 → + Canvas
#   3 → + React Three Fiber
#   4 → + shaders
#   5 → + Digital Twin 3D completo
VITE_VISUAL_LAYER=1

# ── Desarrollo ─────────────────────────────────────────────────────────
# Muestra el monitor de presupuesto de movimiento (FPS, animaciones activas).
VITE_MOTION_DEBUG=false
